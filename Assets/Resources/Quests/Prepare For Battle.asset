  m_Script: {fileID: 11500000, guid: ec593b57273a81f4192006f47ceb121a, type: 3}
  m_Name: Prepare For Battle
  m_EditorClassIdentifier: 
  questName: Prepare For Battle
  questSteps:
  - stepName: clockModule
    objectiveText: place a clock module from your inventory into Weapon 1
    dependencies: []
  - stepName: sourceModule
    objectiveText: place catalyst module from your inventory into Weapon 1
    dependencies: []
  - stepName: connectModules
    objectiveText: 'plug your clock module [OUT] into your catalyst module [TRIG]'
    dependencies:
    - clockModule
    - sourceModule
  - stepName: connectWeapon
    objectiveText: 'plug your catalyst module [OUT] into Weapon 1''s [PATCH END]'
    dependencies:
    - clockModule
    - sourceModule
    - connectModules
  - stepName: startCombat
    objectiveText: press Start Combat
    dependencies:
    - clockModule
    - sourceModule
    - connectModules
    - connectWeapon
  - stepName: winCombat
    objectiveText: win the battle
    dependencies:
    - startCombat
  - stepName: purchaseShop
    objectiveText: open the shop and buy something
    dependencies:
    - winCombat
